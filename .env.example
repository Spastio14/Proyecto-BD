# Backend: usar una base PostgreSQL local o de pruebas en desarrollo.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/postgres
APP_ENV=development
APP_TIMEZONE=America/Managua

# Supabase: valores públicos o referencias locales; nunca guardar secretos reales.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend: únicamente valores seguros para exponer al navegador.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
